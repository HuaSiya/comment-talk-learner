{
  "manifest_version": 2,
  "id": "github.husiya.comment-talk-learner",
  "version": "0.2.5",
  "name": "B站+贴吧学说话 / Comment Talk Learner",
  "description": "每天从B站热门/指定来源的评论区与百度贴吧楼层提取真人说话方式，去重过滤后写入麦麦的表达方式库，让麦麦的日常回复更像群友。",
  "author": {
    "name": "HuaSiya",
    "url": "https://github.com/HuaSiya"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/HuaSiya/comment-talk-learner",
    "homepage": "https://github.com/HuaSiya/comment-talk-learner",
    "documentation": "https://github.com/HuaSiya/comment-talk-learner/blob/main/README.md",
    "issues": "https://github.com/HuaSiya/comment-talk-learner/issues"
  },
  "plugin_type": "integration",
  "host_application": {
    "min_version": "1.3.18",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.19.0",
    "max_version": "2.19.99"
  },
  "changelog": "CHANGELOG.md",
  "dependencies": [],
  "capabilities": [
    "llm.generate",
    "database.query",
    "send.text"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
